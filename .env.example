# HHK site configuration. Copy to .env in the project root (next to public/).
# Never commit .env or put it under public/.
#
# Passwords are stored encrypted with HHK\Crypto::encryptMessage(), the same
# format site.cfg used, so existing values can be copied over as-is.

# Database security pepper (was [site] sitePepper)
SITE_PEPPER=""

# Database connection (was [db])
DBMS="MYSQL"
DB_URL="localhost"
DB_USER=""
DB_PASSWORD=""
DB_SCHEMA=""
DB_READONLY_USER=""
DB_READONLY_PASSWORD=""
